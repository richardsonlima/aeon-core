  "components": {
    "schemas": {
      "AuditVerifyIn": {
        "properties": {
          "expect_head": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expect Head"
          }
        },
        "type": "object",
        "title": "AuditVerifyIn",
        "description": "Request body for audit verification: the head hash the chain is expected to end at."
      },
      "CampaignIn": {
        "properties": {
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "campaign": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Campaign"
          },
          "runs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Runs"
          },
          "controls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Controls"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "blast_radius": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blast Radius"
          }
        },
        "type": "object",
        "title": "CampaignIn",
        "description": "Request body for starting a campaign: a target name or an inline campaign, plus overrides."
      },
      "EvaluateIn": {
        "properties": {
          "tool": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Tool"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          },
          "agent": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Agent",
            "default": "default"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved",
            "default": false
          },
          "context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "tool"
        ],
        "title": "EvaluateIn",
        "description": "Body of ``POST /v1/actions/evaluate``: the action to decide on."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KillSwitchIn": {
        "properties": {
          "engaged": {
            "type": "boolean",
            "title": "Engaged"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "engaged"
        ],
        "title": "KillSwitchIn",
        "description": "Request body for the kill switch: engage or release it, with an optional reason."
      },
      "ModeIn": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "ModeIn",
        "description": "Request body for switching the gate mode: ``shadow`` or ``enforce``."
      },
      "PolicyIn": {
        "properties": {
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          }
        },
        "type": "object",
        "title": "PolicyIn",
        "description": "Body of ``PUT /v1/policies/{name}``: a new level and/or whether the axiom is enabled."
      },
      "ResultIn": {
        "properties": {
          "action_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Id"
          },
          "tool": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Tool"
          },
          "agent": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Agent",
            "default": "default"
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Latency Ms"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": true
          },
          "tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tokens"
          },
          "cost": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost"
          }
        },
        "type": "object",
        "required": [
          "tool",
          "latency_ms"
        ],
        "title": "ResultIn",
        "description": "Body of ``POST /v1/actions/result``: how an evaluated action went (``latency_ms`` in ms)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
